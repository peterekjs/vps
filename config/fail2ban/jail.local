# /etc/fail2ban/jail.local — Fail2ban jail configuration
# Managed by: scripts/setup/00-security-hardening.sh
#
# This file overrides defaults from /etc/fail2ban/jail.conf.
# Only settings that differ from the distribution defaults are listed here.

[DEFAULT]
# Default ban duration (applies to any jail that does not override bantime)
bantime  = 3600
# 10-minute window in which failures are counted
findtime = 600
# Default failure threshold before banning (individual jails may override this)
maxretry = 5

# Send alerts to the local root mailbox (set to a real address if desired)
destemail = root@localhost
sendername = Fail2ban
mta = sendmail
action = %(action_mwl)s

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
[sshd]
enabled  = true
port     = ssh
filter   = sshd
backend  = systemd
logpath  = /var/log/auth.log
maxretry = 3
bantime  = 86400
